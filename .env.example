# CodeJam Backend Environment Variables
# Copy this file to .env and fill in your values
# NEVER commit .env to git!

# ==================== GHCR ====================
GHCR_OWNER=codejam-dev
IMAGE_TAG=latest

# ==================== DATABASE ====================
POSTGRES_DB=codejam_db
POSTGRES_USER=codejam
POSTGRES_PASSWORD=

# ==================== JWT ====================
# Generate with: openssl rand -base64 64
JWT_SECRET=
# Optional separate HS256 key for refresh tokens (defaults to JWT_SECRET if empty)
JWT_REFRESH_SECRET=

# Access token TTL (ms), default 15m
ACCESS_TOKEN_EXPIRY_MS=900000
# Refresh token TTL (ms), default 7d
REFRESH_TOKEN_EXPIRY_MS=604800000

# ==================== URLS ====================
FRONTEND_URL=https://your-frontend.example
# Public backend URL (OAuth redirect, CORS)
GATEWAY_BASE_URL=https://your-api.example

# ==================== GOOGLE OAUTH ====================
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ==================== EMAIL ====================
EMAIL_PROVIDER=resend
RESEND_API_KEY=
RESEND_FROM_EMAIL=

MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=

# ==================== CONFIG SERVER ====================
CONFIG_REPO_URL=https://github.com/your-org/config-repo.git
CONFIG_GIT_BRANCH=main
GIT_USERNAME=
GIT_PASSWORD=

# ==================== LOCAL DEV COOKIES ====================
# For http://localhost use false + Lax; production HTTPS uses true + None (set in docker-compose.prod)
REFRESH_COOKIE_SECURE=false
REFRESH_COOKIE_SAME_SITE=Lax

# ==================== OPTIONS ====================
OTP_ENABLE_DYNAMIC=true
